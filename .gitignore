node_modules
dist
.DS_Store

# gerado ou pesado demais para o git (ficam só no disco)
docs/capturas/video/
arte/.venv/
arte/saida/
__pycache__/

# arte/entradas: 6,3 GB de entradas e downloads do Tripo/Meshy.
# Os binários ficam fora; os prompts e logs (1,5 MB) entram, porque documentam
# como cada peça do Neto foi pedida e o que cada geração respondeu.
arte/entradas/**
!arte/entradas/**/
!arte/entradas/**/*.txt
!arte/entradas/**/*.json
!arte/entradas/**/*.md

# os log-*.txt são a transcrição da sessão que gerou a imagem: 147 MB, quase tudo
# imagem em base64. O que vale guardar é o pedido (pedido-*.txt), que é pequeno.
arte/entradas/**/log-*.txt

# arte/finais tem 1,9 GB. Só o que o jogo carrega entra no git (41 MB em 17
# arquivos); o resto é trabalho intermediário (renders, vídeos, iterações do gato
# e da rotoscopia) e fica fora.
arte/finais/*
!arte/finais/avo-mpfb-receita.txt
!arte/finais/avo-mpfb-sem-rosto-ancoras.json
!arte/finais/avo-mpfb-sem-rosto.glb
!arte/finais/avo-mpfb.glb
!arte/finais/avo-tripo.glb
!arte/finais/neto-base.glb
!arte/finais/neto-folha-final.png
!arte/finais/neto-mpfb-sem-rosto-ancoras.json
!arte/finais/neto-mpfb-sem-rosto.glb
!arte/finais/neto-mpfb.glb
!arte/finais/neto-tripo-p2.glb
!arte/finais/neto-tripo-partes.glb
!arte/finais/neto-tripo-v3.glb
!arte/finais/neto-tripo.glb
!arte/finais/neto-v5-jolt.glb
!arte/finais/neto-v6-corpo.glb
!arte/finais/neto-vestido-folha.jpg
!arte/finais/neto-vestido.glb

# movimentos do Mixamo: licença permite usar no jogo, não redistribuir os arquivos crus
public/animacoes

# geometria preparada da vg (node scripts/preparar-geometria.mjs gera de novo)
public/vg/

# relatório da medição da roupa: sai a cada rodada da bancada (arte/visor/medir-cobertura-motores.mjs)
arte/visor/cobertura-jolt.json

# log do servidor de desenvolvimento que o gravador de video usa
arte/visor/aprovacao/vite.log
